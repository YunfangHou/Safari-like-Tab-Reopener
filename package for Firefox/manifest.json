{
    "manifest_version": 2,
    "name": "Re-open Closed Tab with Cmd + Z",
    "version": "1.4",
    "description": "Reopens closed tabs with Cmd/Ctrl + Z while respecting editing fields and excluded websites.",
    "permissions": [
        "activeTab",
        "contextMenus",
        "tabs",
        "sessions",
        "storage"
    ],
    "icons": {
        "32": "icons/icon-32.png",
        "64": "icons/icon-64.png",
        "96": "icons/icon-96.png",
        "128": "icons/icon-128.png",
        "256": "icons/icon-256.png",
        "512": "icons/icon-512.png"
    },
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": false
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "browser_action": {
        "default_icon": {
            "32": "icons/icon-32.png",
            "64": "icons/icon-64.png",
            "96": "icons/icon-96.png",
            "128": "icons/icon-128.png",
            "256": "icons/icon-256.png",
            "512": "icons/icon-512.png"
        },
        "default_title": "Excluded websites",
        "default_popup": "popup.html"
    },
    "commands": {
        "reopen_last_tab": {
            "suggested_key": {
                "default": "Ctrl+Shift+T",
                "mac": "Command+Shift+T"
            },
            "description": "Reopen the last closed tab"
        }
    }
}
